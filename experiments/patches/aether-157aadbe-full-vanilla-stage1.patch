 SelectClientAction& Aether::MakeSelectClient(Client::ptr const& client) {
+  if (!client.is_valid()) {
+    return MakeSelectClient();
+  }
+  auto loaded = client.Load();
+  if (!loaded) {
+    return MakeSelectClientLoadFailed({}, client.id());
+  }
   auto [it, ok] = select_client_actions_.emplace(
