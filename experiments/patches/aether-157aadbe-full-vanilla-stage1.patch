+SelectClientAction& Aether::MakeSelectClientLoadFailed(
+    std::string const& client_id, ObjId backing_obj_id) {
+  AE_TELED_DEBUG("SelectClient load failed client_id={} obj_id={}", client_id,
+                 backing_obj_id.id());
+  std::string const key =
+      client_id.empty() ? "load_failed" : ("load_failed:" + client_id);
+  if (auto it = select_client_actions_.find(key);
+      it != std::end(select_client_actions_)) {
+    if (it->second->is_finished()) {
+      it->second = std::make_unique<SelectClientAction>(*this, 3);
+    }
+    return *it->second;
+  }
+  auto [it, _] = select_client_actions_.emplace(
+      key, std::make_unique<SelectClientAction>(*this, 3));
+  return *it->second;
+}
