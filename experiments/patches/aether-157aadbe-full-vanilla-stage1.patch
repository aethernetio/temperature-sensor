+int run_test_select_client_stale_map() {
+  using namespace ae::test_select_client_stale_map;  // NOLINT
+  UNITY_BEGIN();
+  RUN_TEST(test_select_client_missing_storage_object_emits_error_3);
+  return UNITY_END();
+}
