diff --git a/aether/server.cpp b/aether/server.cpp
index 2ebcfde..0aff82e 100644
--- a/aether/server.cpp
+++ b/aether/server.cpp
@@ -64,4 +64,19 @@ void Server::AddChannels(AccessPoint::ptr const& access_point) {
   channels_changed_.Emit();
 }
 
+void Server::RebuildChannelsFromAdapters() {
+  channels.clear();
+  if (!adapter_registry_.is_valid()) {
+    return;
+  }
+  adapter_registry_.WithLoaded([&](auto const& ar) {
+    for (auto const& adapter : ar->adapters()) {
+      for (auto const& ap : adapter->access_points()) {
+        AddChannels(ap);
+      }
+    }
+  });
+  channels_changed_.Emit();
+}
+
 }  // namespace ae
