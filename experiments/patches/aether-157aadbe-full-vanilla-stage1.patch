+
+#if AE_SUPPORT_REGISTRATION
+
+namespace ae {
+
+struct AetherSelectClientTestAccess {
+  static void InsertStaleClient(Aether& aether, std::string const& client_id,
+                                Client::ptr client) {
+    aether.clients_[client_id] = std::move(client);
+  }
+};
+
+namespace test_select_client_stale_map {
+
+void test_select_client_missing_storage_object_emits_error_3() {
+  MapDomainStorage storage;
+  Domain domain{Now(), storage};
+  auto aether_ptr = Aether::ptr::Create(CreateWith{domain});
+  auto* aether = aether_ptr.Load().get();
+
+  constexpr ObjId::Type kMissingObj = 2079829250;
+  Client::ptr stale{domain, ObjId{kMissingObj},
+                    ObjFlags::kUnloadedByDefault};
+  AetherSelectClientTestAccess::InsertStaleClient(
+      *aether, "reliability_full_v1", std::move(stale));
+
+  auto const parent =
+      Uid::FromString("b1ac52c8-8d94-bd39-4c01-a631ac594165");
+
+  bool done = false;
+  int err = 0;
+  auto sub =
+      aether->SelectClient(parent, "reliability_full_v1")
+          .result_event()
+          .Subscribe([&](Result<Client::ptr, int> res) {
+            done = true;
+            if (!res) {
+              err = res.error();
+            }
+          });
+
+  while (!done) {
+    (void)aether->task_scheduler->Update(Now());
+  }
+
+  TEST_ASSERT_TRUE(done);
+  TEST_ASSERT_EQUAL_INT(3, err);
+  (void)sub;
+}
+
+}  // namespace test_select_client_stale_map
+}  // namespace ae
+
+int run_test_select_client_stale_map() {
+  using namespace ae::test_select_client_stale_map;  // NOLINT
+  UNITY_BEGIN();
+  RUN_TEST(test_select_client_missing_storage_object_emits_error_3);
+  return UNITY_END();
+}
+
+#else
+
+int run_test_select_client_stale_map() { return 0; }
+
+#endif  // AE_SUPPORT_REGISTRATION
